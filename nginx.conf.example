# =============================================================================
# Nginx Configuration - Koperasi Maju Bersama
# =============================================================================
# Deployment topology:
#   Internet → Nginx (port 80/443) → Backend Hono (port 3000)
#                                  → Frontend static files
#
# Rate limit strategy:
#   - Login endpoint  : 5 req / 15 menit per IP (sesuai logika backend)
#   - API umum        : 60 req / menit per IP
#   - Static files    : tidak di-rate-limit
#
# Catatan: Set RATE_LIMIT_ENABLED=false di .env agar backend tidak
#   melakukan rate limit ganda (karena nginx sudah menanganinya).
# =============================================================================

# Rate limit zones (defined in http context)
# Format: limit_req_zone <key> zone=<name>:<size> rate=<rate>;
#
# Login: 5 req per 15 menit ≈ 0.33 req/menit → gunakan burst untuk fleksibilitas
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=1r/m;

# API umum: 60 req/menit
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=60r/m;

# Upstream backend
upstream koperasi_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name koperasi.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name koperasi.example.com;

    # SSL/TLS
    ssl_certificate     /etc/letsencrypt/live/koperasi.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/koperasi.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header X-Frame-Options           "SAMEORIGIN"   always;
    add_header X-Content-Type-Options    "nosniff"      always;
    add_header X-XSS-Protection          "1; mode=block" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Frontend static files (hasil `bun run build`)
    root /var/www/koperasi/dist;
    index index.html;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # -------------------------------------------------------------------------
    # Login endpoint — rate limit ketat
    # burst=5  : izinkan antrian hingga 5 request sebelum tolak
    # nodelay  : proses burst segera, jangan delay
    # Efektif  : 5 request bisa masuk sekaligus, lalu 1 req/menit berikutnya
    # -------------------------------------------------------------------------
    # Canonical auth prefix: /api/v1/auth/* (legacy /api/v1/login still forwarded by app)
    location = /api/v1/auth/login {
        limit_req zone=login_limit burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;

        proxy_pass         http://koperasi_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # -------------------------------------------------------------------------
    # Google SSO endpoint — rate limit sama seperti login
    # -------------------------------------------------------------------------
    location ~ ^/api/v1/auth/google$ {
        limit_req zone=login_limit burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;

        proxy_pass         http://koperasi_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # -------------------------------------------------------------------------
    # API umum — rate limit longgar
    # -------------------------------------------------------------------------
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass         http://koperasi_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Timeout
        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
        proxy_send_timeout    10s;
    }

    # -------------------------------------------------------------------------
    # Frontend SPA — fallback ke index.html untuk client-side routing
    # -------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Sembunyikan file sensitif
    location ~ /\. {
        deny all;
    }
}
