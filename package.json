{
  "name": "koperasi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src server shared",
    "preview": "vite preview",
    "test": "JWT_SECRET=test-secret-key-123 bun test server src shared scripts",
    "openapi:check": "bun run scripts/openapi-check.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts --project=chromium",
    "db:migrate": "bun -e \"import('./server/db.ts').then(() => process.exit(0))\"",
    "start": "bun run server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.1.3",
    "@astryxdesign/core": "^0.1.3",
    "@astryxdesign/theme-neutral": "^0.1.3",
    "@heroicons/react": "^2.2.0",
    "focus-trap-react": "^12.0.3",
    "hono": "^4.12.28",
    "otplib": "^13.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "5.8.3",
    "vite": "^8.1.1"
  }
}
