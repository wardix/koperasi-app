# =============================================================================
# Environment Variables - Koperasi Maju Bersama
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in the values before running.
#   cp .env.example .env
#
# WARNING: Never commit your actual .env file to version control.
# =============================================================================

# JWT Secret for signing authentication tokens.
# REQUIRED: You MUST replace this placeholder with a strong, randomly generated secret.
# Do NOT use this default value in production.
#
# To generate a secure secret, run one of the following:
#   openssl rand -hex 64
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   bun -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here

# CORS Origins - comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://koperasi.yourdomain.com
CORS_ORIGIN=http://localhost:5173,https://koperasi.example.com

# Backend Server Port (default: 3000)
PORT=3000

# Enable/disable built-in rate limiting on login endpoint (default: true)
# Set to false when using a reverse proxy (e.g., nginx) that handles rate limiting.
RATE_LIMIT_ENABLED=true

# PostgreSQL Connection String
DATABASE_URL=postgres://koperasi:koperasi_pass@localhost:5432/koperasi

# Frontend API Base URL (used when not proxied through Vite dev server)
# In production, set this to your backend's public URL.
# VITE_API_URL=http://localhost:3000

# Google OAuth Client ID for SSO
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
