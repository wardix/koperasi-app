# JWT Secret for backend authentication
# In production, DO NOT use this default value. Generate a secure random string.
JWT_SECRET=koperasi-super-secret-key-2026

# CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,https://koperasi.example.com

# Google OAuth Client ID for SSO
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
