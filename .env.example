# =============================================================================
# Environment Variables - Koperasi Maju Bersama
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in the values before running.
#   cp .env.example .env
#
# WARNING: Never commit your actual .env file to version control.
# =============================================================================

# =============================================================================
# SECURITY CRITICAL VARIABLES (REQUIRED FOR PRODUCTION)
# =============================================================================

# JWT Secret for signing authentication tokens.
# REQUIRED: Must be strong random value. No fallback allowed in production.
# Generate with: openssl rand -hex 64
# Length should be at least 32 bytes (64 hex chars)
JWT_SECRET=your-jwt-secret-key-here

# PostgreSQL connection string (REQUIRED for app + tests).
# This project does NOT use SQLite. Match docker-compose `db` service for local dev:
#   user: koperasi  password: koperasi_pass  db: koperasi  port: 5432
# Example with Docker Compose DB:
#   DATABASE_URL=postgres://koperasi:koperasi_pass@localhost:5432/koperasi
# Example against remote/managed Postgres (RECOMMENDED for production):
#   DATABASE_URL=postgres://user:pass@db.example.com:5432/koperasi?sslmode=require
DATABASE_URL=postgres://koperasi:koperasi_pass@localhost:5432/koperasi

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# CORS Origins - comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://koperasi.yourdomain.com
CORS_ORIGIN=http://localhost:5173,https://koperasi.example.com

# Backend Server Port (default: 3000)
PORT=3000

# Enable/disable built-in rate limiting on login endpoint (default: true)
# Set to false when using a reverse proxy (e.g., nginx) that handles rate limiting.
RATE_LIMIT_ENABLED=true

# Frontend API Base URL (used when not proxied through Vite dev server)
# In production, set this to your backend's public URL.
# VITE_API_URL=http://localhost:3000

# Google OAuth Client ID for SSO
# Get yours at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# SECURITY NOTES FOR PRODUCTION DEPLOYMENT
# =============================================================================
# 1. NODE_ENV must be set to 'production' for production deployments
# 2. DATABASE_URL and JWT_SECRET are REQUIRED - no fallbacks allowed
# 3. Default admin password (admin123) is ONLY seeded in development/test
# 4. Production requires explicit bootstrap via secure channels (SSH, vault)
# 5. Never expose PostgreSQL port (5432) to host network in production
# 6. Use SSL/TLS for database connections in production (?sslmode=require)
